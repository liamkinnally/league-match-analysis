# Include only application build inputs.
**
!backend/mvnw
!backend/pom.xml
!backend/src/**
!frontend/src/**
!frontend/public/**
!frontend/e2e/**
!frontend/e2e-package/**
!frontend/e2e-visual/**
!frontend/Dockerfile
!frontend/Dockerfile.visual
!frontend/package.json
!frontend/package-lock.json
!frontend/next.config.ts
!frontend/tsconfig.json
!frontend/eslint.config.mjs
!frontend/postcss.config.mjs
!frontend/vitest.config.mts
!frontend/playwright.config.ts
!frontend/playwright.package.config.ts
!frontend/playwright.visual.config.ts
!frontend/vercel.json

# Exclude hidden files, credentials and generated output within allowed paths.
**/.*
**/.*/**
**/node_modules/**
**/target/**
**/playwright-report/**
**/test-results/**
**/*.har
**/*.log
**/*.key
**/*.pem
**/*.p12

# Maven needs this versioned wrapper configuration.
!backend/.mvn/wrapper/maven-wrapper.properties
