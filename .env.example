POSTGRES_DB=league_analysis
POSTGRES_USER=league_analysis
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
FRONTEND_PORT=3416

# Riot API keys belong only in ignored local environment files.
RIOT_API_KEY=
RIOT_PUBLIC_LOOKUP_ENABLED=false

# Optional for private local Compose; required for the hosted Railway backend.
# Use a separately generated random value of at least 32 characters, not a Riot key.
BACKEND_SERVICE_TOKEN=
BACKEND_AUTH_REQUIRED=false

# Public contact shown on the prototype's policy pages.
PROTOTYPE_CONTACT_EMAIL=
# Portal-issued public verification string. This is NOT RIOT_API_KEY.
RIOT_VERIFICATION_TOKEN=
