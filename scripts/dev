#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
repo_dir=$(cd "$script_dir/.." && pwd -P)
backend_dir="$repo_dir/backend"
frontend_dir="$repo_dir/frontend"
evidence_revision="ev_1111111111111111111111111111111111111111111111111111111111111111"
selection_query="focus=6&object=trn_000000000000000000000002&start=780275&end=900291&question=advantage-conversion&evidence=${evidence_revision}"

usage() {
  cat <<'EOF'
Usage:
  ./scripts/dev [live]
  ./scripts/dev app
  ./scripts/dev fixture
  ./scripts/dev ui
EOF
}

print_command() {
  printf '%q ' "$@"
  printf '\n'
}

print_lab_urls() {
  cat <<EOF
UI lab scenarios:
  http://127.0.0.1:3000/matches/__lab_normal?focus=6
  http://127.0.0.1:3000/matches/__lab_investigation?${selection_query}&mode=investigate&lens=SEQUENCE
  http://127.0.0.1:3000/matches/__lab_sparse?focus=6
  http://127.0.0.1:3000/matches/__lab_unsupported?${selection_query}&lens=CHAMPION_TIMING
EOF
}

run_ui() {
  print_lab_urls
  if [[ "${DEV_DRY_RUN:-0}" == "1" ]]; then
    printf '(cd %q && ' "$frontend_dir"
    print_command env -u RIOT_API_KEY NEXT_PUBLIC_RIOT_API_KEY= UI_LAB_ENABLED=1 LEAGUE_ANALYSIS_RUNTIME=local npm run dev
    printf ')\n'
  else
    (cd "$frontend_dir" && env -u RIOT_API_KEY NEXT_PUBLIC_RIOT_API_KEY= UI_LAB_ENABLED=1 LEAGUE_ANALYSIS_RUNTIME=local npm run dev)
  fi
}

[[ $# -le 1 ]] || { usage >&2; exit 2; }

case "${1:-live}" in
  live|app|fixture) exec node "$script_dir/dev-stack.mjs" "${1:-live}" ;;
  ui) run_ui ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
