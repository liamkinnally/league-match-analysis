BACKEND_URL=http://127.0.0.1:8080
BACKEND_SERVICE_TOKEN=
BACKEND_AUTH_REQUIRED=false
PROTOTYPE_CONTACT_EMAIL=
RIOT_VERIFICATION_TOKEN=

# The deterministic UI lab is server-only and opt-in. Ordinary development and
# deployed production should leave both values unset; `./scripts/dev ui` supplies
# the safe local values without editing this file.
# UI_LAB_ENABLED=1
# LEAGUE_ANALYSIS_RUNTIME=local

# Preview-only data mode: backend (default) or sample (no backend requests).
# Sample also supports local verification with LEAGUE_ANALYSIS_RUNTIME=verification.
# Vercel Production always uses the backend, regardless of this value.
# PREVIEW_DATA_SOURCE=sample
