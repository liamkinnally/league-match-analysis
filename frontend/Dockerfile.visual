FROM node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS node-runtime

FROM ubuntu:noble@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8
WORKDIR /workspace/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
RUN ./node_modules/.bin/playwright install-deps chromium && rm -rf /var/lib/apt/lists/*

ENV LEAGUE_VISUAL_CONTAINER=1
COPY frontend/test-browser.cjs frontend/test-browser-pins.json ./
RUN node test-browser.cjs install

COPY frontend/ ./

ENV NEXT_TELEMETRY_DISABLED=1
ENV UI_LAB_ENABLED=1
ENV LEAGUE_ANALYSIS_RUNTIME=verification

RUN npm run build
RUN cp -R .next/static .next/standalone/.next/static
RUN cp -R public .next/standalone/public

RUN chown ubuntu:ubuntu .
USER ubuntu

CMD ["npm", "run", "test:visual:raw"]
